{
  "http_api": {
    "key": "centrifugo-api-key-change-me"
  },
  "admin": {
    "enabled": false
  },
  "client": {
    "allowed_origins": ["*"],
    "channel_limit": 128,
    "proxy": {
      "connect": {
        "enabled": true,
        "endpoint": "http://host.docker.internal:8080/api/internal/centrifugo/connect",
        "timeout": "5s",
        "http_headers": ["Cookie"]
      }
    }
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://host.docker.internal:8080/api/internal/centrifugo/subscribe",
        "timeout": "5s",
        "http_headers": ["Cookie"]
      }
    },
    "namespaces": [
      {
        "name": "workspace",
        "presence": true,
        "join_leave": false,
        "history_size": 100,
        "history_ttl": "300s",
        "force_recovery": true,
        "subscribe_proxy_enabled": true
      },
      {
        "name": "views",
        "presence": false,
        "join_leave": false,
        "history_size": 50,
        "history_ttl": "120s",
        "force_recovery": true,
        "subscribe_proxy_enabled": true
      }
    ]
  }
}
