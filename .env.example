# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizengine
DB_PASSWORD=bizengine
DB_NAME=bizengine
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222
NATS_ENABLED=false

# Session
SESSION_TTL=72h
SESSION_SEANCE_TTL=10m
SESSION_COOKIE_SECURE=false

# Centrifugo
CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=centrifugo-api-key-change-me

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug

# Environment
ENV=development
