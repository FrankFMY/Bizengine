# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bizengine
DB_PASSWORD=bizengine
DB_NAME=bizengine
DB_SSLMODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222
NATS_ENABLED=false

# JWT
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Logging
LOG_LEVEL=debug

# Environment
ENV=development
